{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "test": "jest",
    "test:unit": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:unit:cov": "jest --coverage --runInBand --ci",
    "test:ci": "npm run lint:ci && npm run build && npm run test:unit:cov",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json",
    "test:e2e:env": "bash scripts/test-e2e-env.sh",
    "test:e2e:ci": "bash scripts/test-e2e-ci.sh",
    "db:create:test": "bash scripts/db-create-test.sh",
    "db:drop:test": "bash scripts/db-drop-test.sh",
    "db:reset:test": "bash scripts/db-reset-test.sh"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ethers": "^6.13.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.15.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.23"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!main.ts",
      "!migrations/**",
      "!__assets/**",
      "!__events/**",
      "!__payments/**",
      "!tokenshop/tokenshop-admin*",
      "!tokenshop/tokenshop-analytics*",
      "!tokenshop/tokenshop-chain*",
      "!tokenshop/tokenshop-query*",
      "!tokenshop/tokenshop-quotes*",
      "!tokenshop/tokenshop-shop*",
      "!tokenshop/tokenshop-sync*",
      "!tokenshop/tokenshop-user*",
      "!tokenshop/guards/**",
      "!economics/economics.controller.ts",
      "!economics/player-economics.service.ts",
      "!admin/admin-dev.controller.ts",
      "!admin/admin-dev.service.ts",
      "!tokenshop/tokenshop-listener.service.ts"
    ],
    "coverageDirectory": "../coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "migrations"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 64,
        "lines": 85,
        "statements": 85
      },
      "./src/tax/": {
        "branches": 85,
        "functions": 90,
        "lines": 90,
        "statements": 90
      },
      "./src/wallets/": {
        "branches": 85,
        "functions": 90,
        "lines": 90,
        "statements": 90
      },
      "./src/platform/platform.service.ts": {
        "branches": 85,
        "functions": 100,
        "lines": 95,
        "statements": 95
      },
      "./src/platform/studio-member.service.ts": {
        "branches": 85,
        "functions": 100,
        "lines": 95,
        "statements": 95
      },
      "./src/platform/studios.service.ts": {
        "branches": 75,
        "functions": 100,
        "lines": 95,
        "statements": 95
      }
    },
    "testEnvironment": "node"
  }
}
