# Server
PORT=3000
DEV_BOOTSTRAP_KEY=replace_with_random_local_dev_key
ENABLE_UNVERIFIED_WALLET_DEPOSITS=false

# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=wallet
DATABASE_USER=postgres
DATABASE_PASSWORD=your_db_password_here
# Keep this off outside disposable local dev. Tests enable schema sync automatically.
TYPEORM_SYNCHRONIZE=false

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_byte_hex_secret_here

# AES-256 Encryption (must be exactly 32 chars)
ENCRYPTION_KEY=your_32_character_encryption_key_
# AES IV (must be exactly 16 chars)
ENCRYPTION_IV=your_16_char_iv_!!

# Blockchain / Local Hardhat node
RPC_URL=http://127.0.0.1:8545
WS_RPC_URL=ws://127.0.0.1:8545
TOKENSHOP_ADDRESS=0xYourTokenShopContractAddress
FACTORY_ADDRESS=0xYourFactoryContractAddress
DEPLOYER_PRIVATE_KEY=0xYourHardhatTestPrivateKey

# Test database (only needed when NODE_ENV=test)
TEST_DATABASE_HOST=localhost
TEST_DATABASE_PORT=5432
TEST_DATABASE_NAME=wallet_test
TEST_DATABASE_USER=postgres
TEST_DATABASE_PASSWORD=your_test_db_password_here
